generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProcessingRun {
  id               String           @id @default(cuid())
  candidate_id     String
  started_at       DateTime         @default(now())
  finished_at      DateTime?
  total_input      Int              @default(0)
  tasks_created    Int              @default(0)
  tasks_updated    Int              @default(0)
  skipped          Int              @default(0)
  errored          Int              @default(0)
  processed_emails ProcessedEmail[]

  @@index([candidate_id])
  @@map("processing_runs")
}

model Task {
  id               String           @id @default(cuid())
  task_id          String           @unique
  candidate_id     String
  source_email_id  String
  thread_id        String
  title            String
  description      String?
  assignee_id      AssigneeId
  category         Category
  priority         Priority
  due_date         String?
  deal_value_inr   Int?
  company_name     String?
  confidence       Float
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  processed_emails ProcessedEmail[]
  updates          TaskUpdate[]
  thread_map       ThreadTaskMap?

  @@unique([candidate_id, source_email_id])
  @@index([candidate_id])
  @@index([candidate_id, thread_id])
  @@index([candidate_id, assignee_id])
  @@map("tasks")
}

model ThreadTaskMap {
  id           String   @id @default(cuid())
  candidate_id String
  thread_id    String
  task_id      String   @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  task         Task     @relation(fields: [task_id], references: [task_id])

  @@unique([candidate_id, thread_id])
  @@index([candidate_id])
  @@map("thread_task_map")
}

model ProcessedEmail {
  id              String        @id @default(cuid())
  candidate_id    String
  source_email_id String
  thread_id       String
  from_name       String?
  from_email      String?
  subject         String?
  received_at     DateTime?
  is_reply        Boolean       @default(false)
  raw_body        String?
  decision        EmailDecision
  category        Category?
  assignee_id     AssigneeId?
  priority        Priority?
  due_date        String?
  deal_value_inr  Int?
  company_name    String?
  confidence      Float?
  reasoning       String?
  skip_reason     SkipReason?
  error_message   String?
  task_id         String?
  run_id          String
  created_at      DateTime      @default(now())
  run             ProcessingRun @relation(fields: [run_id], references: [id])
  task            Task?         @relation(fields: [task_id], references: [task_id])

  @@unique([candidate_id, source_email_id])
  @@index([candidate_id])
  @@index([candidate_id, thread_id])
  @@index([candidate_id, decision])
  @@index([candidate_id, category])
  @@index([run_id])
  @@map("processed_emails")
}

model TaskUpdate {
  id                  String      @id @default(cuid())
  task_id             String
  candidate_id        String
  source_email_id     String
  thread_id           String
  prev_priority       Priority?
  new_priority        Priority?
  prev_due_date       String?
  new_due_date        String?
  prev_deal_value_inr Int?
  new_deal_value_inr  Int?
  prev_assignee_id    AssigneeId?
  new_assignee_id     AssigneeId?
  prev_confidence     Float?
  new_confidence      Float?
  prev_company_name   String?
  new_company_name    String?
  created_at          DateTime    @default(now())
  task                Task        @relation(fields: [task_id], references: [task_id])

  @@index([task_id])
  @@index([candidate_id, thread_id])
  @@map("task_updates")
}

enum AssigneeId {
  u_aarti
  u_rohit
  u_meera
  u_karan
  u_divya
  u_triage
}

enum Category {
  enterprise_rfp
  smb_enquiry
  marketing
  alliances
  finance
  triage
}

enum Priority {
  high
  medium
  low
}

enum EmailDecision {
  created
  updated
  skipped
  errored
}

enum SkipReason {
  out_of_office
  newsletter
  spam
}
